# Copy to .env and fill in. Never commit .env.

# The one key Gobo needs: Comfy Router. Make it at https://platform.comfy.org
# (API keys) and add credits there. Every model, the Director and the shot-list
# planner run on it.
COMFY_API_KEY=

# Sign-in (either one turns it on; neither = anyone who can reach the address
# can use it and spend your credits)
STUDIO_PASSWORD=                  # one shared password; people type their own name with it
# STUDIO_USERS=ana:pw1,ben:pw2    # separate logins instead
# STUDIO_SESSION_DAYS=30
# STUDIO_SECRET=                  # signs the sign-in cookie; made and kept in the data folder if unset

# A public demo instead: every visitor signs in with their OWN Comfy key (held
# in memory only) and sees only their own reels. No key of yours is spent.
# STUDIO_KEYS=visitor

# Optional extras
# ANTHROPIC_API_KEY=              # the Director and planner from Anthropic, instead of through Comfy Router
# OPENAI_API_KEY=                 # GPT-4o writes "prompts from a reference"
# SEGMIND_API_KEY=                # a second catalogue: ~300 more models on Segmind (https://segmind.com)
# STUDIO_ENGINES=comfy            # which catalogues to show: comfy, segmind, or both
# AZURE_STORAGE_CONNECTION_STRING=   # Segmind only: references go to a private blob container behind a 48-hour link
# STUDIO_BLOB_CONTAINER=studio-inputs

# Optional
# STUDIO_DIR=data                 # where reels live (the Docker image uses /data)
# STUDIO_PREFIX=/studio           # URL path the studio is served under
# STUDIO_REEL_TTL_DAYS=60         # reels untouched this long are purged
# STUDIO_DIRECTOR_MODEL=claude-opus-5-5
# STUDIO_DIRECTOR_EFFORT=low
# STUDIO_PLANNER_EFFORT=medium
# STUDIO_VIDEO_LANE=4             # clips at once per provider before the rest wait in line
# STUDIO_LOW_CREDIT=50            # the balance turns amber below this
# STUDIO_COMFY_SYNC=1             # run every take on Comfy's direct route (if its queue sticks)
# STUDIO_ENABLED=1                # 0 = kill switch: page and API answer 503
